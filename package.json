{
  "name": "tartagal-go",
  "version": "1.0.0",
  "private": true,
  "description": "TARTAGAL GO — directorio digital de comercios, profesionales y servicios de Tartagal, Salta.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run catalog:validate && next build && node scripts/postbuild-rsc-paths.mjs && node scripts/postbuild-csp.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "business:new": "tsx scripts/new-business.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "author": "Facundo Gorriti"
}
