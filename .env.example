# TARTAGAL GO — variables PÚBLICAS de despliegue.
# Todas las variables NEXT_PUBLIC_* se incrustan en el JavaScript enviado al navegador.
# NUNCA colocar aquí secretos, claves privadas ni tokens.

# URL pública canónica del sitio (sin barra final). Obligatoria en producción.
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com.ar

# Contacto público para "Sumar mi negocio" y "Contacto". Dejar vacío si aún no existe:
# el sitio mostrará "configuración pendiente" en lugar de inventar datos.
NEXT_PUBLIC_CONTACT_EMAIL=
# Número de WhatsApp en formato internacional, solo dígitos (ej: 5493873000000).
NEXT_PUBLIC_CONTACT_WHATSAPP=

# "true" para mostrar los negocios de demostración (ficticios). Por defecto: true.
NEXT_PUBLIC_SHOW_DEMO_BUSINESSES=true
